<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Webapp Money sempre accesa su http://127.0.0.1:8787 (solo locale). Facoltativo.
     Prima: cd web && npm run build
     Installazione: cp infra/web/com.money.web.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.money.web.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.money.web</string>
  <key>WorkingDirectory</key><string>/Users/martinmiccoli/money/web</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-lc</string><string>exec npx tsx server/index.ts</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/martinmiccoli/money/data/logs/web.log</string>
  <key>StandardErrorPath</key><string>/Users/martinmiccoli/money/data/logs/web.log</string>
</dict>
</plist>
