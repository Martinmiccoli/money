{
  "name": "money-web",
  "private": true,
  "type": "module",
  "description": "API (Hono) e webapp PWA (React) del progetto money — M7",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
