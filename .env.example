# Copia in .env (ignorato da git) e compila. MAI committare .env (G-14).
POSTGRES_USER=money
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=money
POSTGRES_PORT=5433
DATABASE_URL=postgresql://money:cambiami@127.0.0.1:5433/money

# Alpaca Paper (https://alpaca.markets, solo email) — chiavi del conto PAPER
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# sip = dati consolidati (storico gratuito oltre 15 min); se non autorizzato si ripiega su iex
ALPACA_FEED=sip

# SEC EDGAR richiede un User-Agent con nome ed email (M5)
SEC_USER_AGENT=

# Notifiche Telegram (M7): crea un bot con @BotFather, scrivigli /start, poi `uv run money notify setup`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webapp (M7): porta locale (solo 127.0.0.1)
WEB_PORT=8787
